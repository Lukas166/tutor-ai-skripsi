generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// BETTER AUTH TABLES (modified)
// ==========================================

model User {
  id            String  @id
  name          String
  email         String  @unique
  emailVerified Boolean
  image         String?

  // Custom fields
  role          String  @default("mahasiswa") // admin | dosen | mahasiswa
  academicLevel String? // S1 | S2 | S3 — hanya untuk mahasiswa
  npm           String? @unique // Nomor Pokok Mahasiswa — hanya untuk mahasiswa
  major         String? // jurusan
  faculty       String? // fakultas
  bio           String?

  createdAt DateTime
  updatedAt DateTime

  // Better Auth relations
  sessions Session[]
  accounts Account[]

  // App relations
  coursesCreated     Course[]           @relation("CourseCreator")
  courseInstructor   CourseInstructor[]
  enrollments        Enrollment[]
  courseSessionsMade CourseSession[]    @relation("CourseSessionCreator")
  materialsUploaded  Material[]
  aiChatSessions     AiChatSession[]
  assessments        AssessmentAttempt[]
  indicatorProfiles  StudentIndicatorProfile[]
  practiceSessions   PracticeSession[]
  learningProgress   StudentLearningProgress[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

// ==========================================
// COURSE MANAGEMENT
// ==========================================

model Course {
  id            String   @id
  createdBy     String
  title         String
  description   String?
  coverImage    String?
  enrollmentKey String   @unique // auto-generated 8 karakter, dipakai mahasiswa untuk join
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator        User               @relation("CourseCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  instructors    CourseInstructor[]
  enrollments    Enrollment[]
  sessions       CourseSession[]
  materialChunks MaterialChunk[]
  aiChatSessions AiChatSession[]
  domainTopics      DomainTopic[]
  assessments    AssessmentAttempt[]
  indicatorProfiles StudentIndicatorProfile[]
  learningConfig CourseLearningConfig?
  learningOutcomes LearningOutcome[]
  domainIndicators DomainIndicator[]
  questionBank QuestionBankItem[]
  practiceSessions PracticeSession[]
  learningProgress StudentLearningProgress[]

  @@index([enrollmentKey])
  @@map("course")
}

// Satu course bisa diampu banyak dosen
model CourseInstructor {
  id         String   @id
  courseId   String
  userId     String // hanya role dosen
  assignedAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@map("course_instructor")
}

// Mahasiswa join course via enrollmentKey
model Enrollment {
  id         String   @id
  courseId   String
  userId     String // hanya role mahasiswa
  isActive   Boolean  @default(true) // false = akses dicabut tanpa hapus histori
  enrolledAt DateTime @default(now())

  course   Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
  @@map("enrollment")
}

// ==========================================
// COURSE CONTENT
// ==========================================

// Minggu 1, Minggu 2, dst — unit konten dalam course
model CourseSession {
  id          String   @id
  courseId    String
  createdBy   String
  title       String // contoh: Minggu 1 - Pengenalan AI
  description String?
  orderNumber Int      @default(1) // urutan tampil, unik per course
  isActive    Boolean  @default(true) // false = tersembunyi dari mahasiswa
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course         Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator        User                 @relation("CourseSessionCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  materials      Material[]
  materialChunks MaterialChunk[]
  aiChatSessions AiChatSession[]
  domainTopics      DomainTopic[]

  @@unique([courseId, orderNumber])
  @@index([courseId])
  @@map("course_session")
}

// File PDF yang diunggah per sesi — satu sesi bisa punya banyak PDF
model Material {
  id              String   @id
  courseSessionId String
  uploadedBy      String
  title           String
  materialType    String   @default("file") // file | link | text
  description     String?
  fileName        String
  filePath        String // legacy path/url agar data lama tetap kompatibel
  storagePath     String? // path object di Supabase Storage
  publicUrl       String? // URL publik file dari Supabase Storage
  externalUrl     String? // URL untuk materi bertipe link
  textContent     String? // konten untuk materi bertipe text
  fileSize        BigInt? // ukuran dalam bytes
  isActive        Boolean  @default(true)
  isProcessed     Boolean  @default(false) // true = embedding selesai, siap dipakai RAG
  processingStatus String   @default("uploaded") // uploaded | queued | processing | extracting | ocr | chunking | embedding | indexing | ready | failed
  processingProgress Int    @default(0)
  processingError String?
  processingJobId String?
  processingStartedAt DateTime?
  processingCompletedAt DateTime?
  pageCount       Int      @default(0)
  chunkCount      Int      @default(0)
  embeddingModel  String?
  embeddingDimensions Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())

  courseSession CourseSession @relation(fields: [courseSessionId], references: [id], onDelete: Cascade)
  uploader      User          @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  pages         MaterialPage[]
  chunks        MaterialChunk[]
  processingLogs MaterialProcessingLog[]

  @@index([courseSessionId])
  @@index([isProcessed])
  @@index([processingStatus])
  @@map("material")
}

// ==========================================
// RAG — VECTOR KNOWLEDGE BASE
// ==========================================

model MaterialPage {
  id                String   @id
  materialId        String
  pageNumber        Int
  embeddedText      String?
  ocrText           String?
  finalText         String
  textCharCount     Int      @default(0)
  imageOcrAttempted Boolean  @default(false)
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, pageNumber])
  @@index([materialId])
  @@map("material_page")
}

model MaterialChunk {
  id         String   @id
  materialId String
  courseId   String
  sessionId  String
  pageNumber Int
  chunkIndex Int
  content    String
  tokenCount Int
  embedding  Unsupported("vector(768)")?
  chunkType  String   @default("page_text")
  metadata   Json?
  createdAt  DateTime @default(now())

  material      Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseSession CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([materialId, chunkIndex])
  @@index([materialId])
  @@index([courseId])
  @@index([sessionId])
  @@index([courseId, sessionId])
  @@index([materialId, pageNumber])
  @@map("material_chunk")
}

model MaterialProcessingLog {
  id         String   @id
  materialId String
  status     String
  message    String
  error      String?
  metadata   Json?
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, createdAt])
  @@map("material_processing_log")
}

// ==========================================
// TUTOR AI — CHAT
// ==========================================

model AiChatSession {
  id              String   @id
  userId          String
  courseId        String
  courseSessionId String // RAG hanya query chunk dari sesi ini
  customTitle     String?  // judul kustom dari user (rename); null = pakai pesan pertama
  startedAt       DateTime @default(now())
  lastActiveAt    DateTime @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseSession CourseSession   @relation(fields: [courseSessionId], references: [id], onDelete: Cascade)
  messages      AiChatMessage[]
  practiceSessions PracticeSession[]

  @@index([userId, courseSessionId])
  @@index([userId])
  @@map("ai_chat_session")
}

model AiChatMessage {
  id              String   @id
  aiChatSessionId String
  senderType      String // user | ai
  content         String // teks pesan
  audioUrl        String? // URL file TTS
  ragSources      Json? // chunk IDs + similarity score
  responseTimeMs  Int? // latensi AI dalam ms
  createdAt       DateTime @default(now())

  aiChatSession AiChatSession @relation(fields: [aiChatSessionId], references: [id], onDelete: Cascade)

  @@index([aiChatSessionId])
  @@map("ai_chat_message")
}

// ==========================================
// TUTOR AI — PROMPT PERSONALISASI
// ==========================================

model TutorPromptConfig {
  id            String   @id @default(cuid())
  academicLevel String   // S1 | S2 | S3
  responseMode  String   // chat | avatar
  promptContent String   // isi prompt gaya akademik
  isDefault     Boolean  @default(true) // true = prompt bawaan sistem, false = sudah diedit admin
  updatedBy     String?  // userId admin yang terakhir edit
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([academicLevel, responseMode])
  @@map("tutor_prompt_config")
}

// Domain pembelajaran berlaku per Course; bank soal/kunci tidak menjadi sumber RAG.
model LearningOutcome {
  id          String @id
  courseId    String
  code        String
  cpmk        String
  description String
  topics      DomainTopicOutcome[]
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([courseId, code])
  @@map("learning_outcome")
}

model DomainTopic {
  id              String @id
  code            String
  courseId        String
  courseSessionId String?
  title           String
  orderNumber     Int
  cpmkCodes       String[]
  subCpmkCodes    String[]
  sourcePdf       String
  sourcePages     String
  course          Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseSession   CourseSession? @relation(fields: [courseSessionId], references: [id], onDelete: SetNull)
  outcomes        DomainTopicOutcome[]
  concepts        DomainConcept[]
  indicators      DomainIndicator[]
  questions       QuestionBankItem[]
  @@unique([courseId, orderNumber])
  @@unique([courseId, code])
  @@map("domain_topic")
}

model DomainTopicOutcome {
  topicId   String
  outcomeId String
  topic     DomainTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  outcome   LearningOutcome @relation(fields: [outcomeId], references: [id], onDelete: Restrict)
  @@id([topicId, outcomeId])
  @@map("domain_topic_outcome")
}

model DomainConcept {
  id         String @id
  code       String
  topicId    String
  name       String
  topic      DomainTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  indicators DomainIndicator[]
  @@unique([topicId, name])
  @@map("domain_concept")
}

model DomainIndicator {
  id           String @id
  code         String
  courseId     String
  topicId      String
  conceptId    String
  description  String
  cpmkCodes    String[]
  subCpmkCodes String[]
  sourcePdf    String
  sourcePages  String
  topic        DomainTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  concept      DomainConcept @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  questions    QuestionBankItem[]
  items        AssessmentItem[]
  profiles     StudentIndicatorProfile[]
  practiceSessions PracticeSession[]
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([courseId, code])
  @@index([topicId])
  @@map("domain_indicator")
}

model QuestionBankItem {
  id               String @id
  code             String
  courseId         String
  topicId          String
  indicatorId      String
  kind             String // PRE_POST | PRACTICE; satu record dipakai kembali pada post-test.
  question         String
  options          Json
  correctOption    String
  explanation      String
  cognitiveLevel   String
  practiceNumber   Int?
  sourcePdf        String
  sourcePages      String
  topic            DomainTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  indicator        DomainIndicator @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  items            AssessmentItem[]
  practiceSessions PracticeSession[]
  course           Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([courseId, code])
  @@unique([indicatorId, kind, practiceNumber])
  @@index([topicId, kind])
  @@map("question_bank_item")
}

model AssessmentAttempt {
  id             String @id
  studentId      String
  courseId       String
  kind           String @default("PRE") // PRE dan POST memakai snapshot paket yang identik.
  status         String @default("IN_PROGRESS")
  startedAt      DateTime @default(now())
  submittedAt    DateTime?
  correctCount   Int?
  totalQuestions Int
  percentage     Float?
  student        User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course         Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items          AssessmentItem[]
  @@unique([studentId, courseId, kind])
  @@map("assessment_attempt")
}

model CourseLearningConfig {
  courseId             String @id
  pretestQuestionCount  Int
  datasetName          String
  datasetChecksum      String
  emaAlpha             Float @default(0.3)
  developingThreshold  Float @default(0.5)
  readyThreshold       Float @default(0.8)
  minimumStudySeconds  Int @default(0)
  course               Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@map("course_learning_config")
}

model AssessmentItem {
  id               String @id
  attemptId        String
  questionId       String
  indicatorId      String
  orderNumber      Int
  questionSnapshot Json // Snapshot privat menjaga penilaian stabil ketika dataset diimpor ulang.
  selectedOption   String?
  isCorrect        Boolean?
  answeredAt       DateTime?
  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuestionBankItem @relation(fields: [questionId], references: [id], onDelete: Restrict)
  indicator        DomainIndicator @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  profile          StudentIndicatorProfile?
  @@unique([attemptId, questionId])
  @@unique([attemptId, indicatorId])
  @@unique([attemptId, orderNumber])
  @@map("assessment_item")
}

model StudentIndicatorProfile {
  id              String @id
  studentId       String
  courseId        String
  indicatorId     String
  baselineItemId  String @unique
  initialScore    Float
  currentScore    Float
  evidenceCount  Int @default(1)
  initialStatus  String // NEEDS_REINFORCEMENT | INITIAL_POSITIVE_EVIDENCE
  currentStatus  String @default("NOT_ASSESSED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())
  student         User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course          Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  indicator       DomainIndicator @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  baselineItem    AssessmentItem @relation(fields: [baselineItemId], references: [id], onDelete: Restrict)
  @@unique([studentId, courseId, indicatorId])
  @@map("student_indicator_profile")
}

// Satu soal latihan berbeda hanya dapat menyumbang satu bukti mandiri per mahasiswa/course.
model PracticeSession {
  id               String @id
  studentId        String
  courseId         String
  chatSessionId    String?
  indicatorId      String
  questionId       String
  status           String @default("OFFERED")
  questionSnapshot Json
  hintCount        Int @default(0)
  answerCount      Int @default(0)
  firstAnsweredAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  student          User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course           Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chatSession      AiChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  indicator        DomainIndicator @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  question         QuestionBankItem @relation(fields: [questionId], references: [id], onDelete: Restrict)
  events           PracticeEvent[]
  @@unique([studentId, courseId, questionId])
  @@index([chatSessionId])
  @@map("practice_session")
}

// Idempotency key, kondisi bantuan, dan EMA sebelum/sesudah menjadi audit penilaian server.
model PracticeEvent {
  id               String @id
  practiceSessionId String
  requestId        String
  kind             String
  selectedOption   String?
  isCorrect        Boolean?
  independent      Boolean @default(false)
  hintCount        Int
  scoreBefore      Float?
  scoreAfter       Float?
  emaAlpha         Float?
  feedback         String
  sources          Json
  createdAt        DateTime @default(now())
  practiceSession  PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  @@unique([practiceSessionId, requestId])
  @@map("practice_event")
}

model StudentLearningProgress {
  studentId     String
  courseId      String
  startedAt     DateTime @default(now())
  lastStudiedAt DateTime @default(now())
  student       User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course        Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@id([studentId, courseId])
  @@map("student_learning_progress")
}
