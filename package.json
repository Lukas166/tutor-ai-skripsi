{
  "name": "tutor-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,ai -c cyan,magenta npm:dev:next npm:dev:ai",
    "dev:next": "next dev --turbo",
    "dev:ai": "tsx scripts/services/start-ai.ts --reload",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "concurrently -n next,ai -c cyan,magenta npm:start:next npm:rag:api",
    "start:next": "next start",
    "lint": "eslint",
    "rag:api": "tsx scripts/services/start-ai.ts",
    "seed:domain:rpl": "uv run --project services/rag --locked python scripts/data/import-rpl.py"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.49.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.2.0",
    "katex": "^0.16.47",
    "lucide": "^1.3.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.184.1",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
